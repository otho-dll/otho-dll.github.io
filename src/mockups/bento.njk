---
# Redesign mockup A. Draft: visible with `npm start` at /mockups/bento/, never published.
title: "Mockup A: Bento"
draft: true
permalink: /mockups/bento/
---
{% extends "layouts/base.njk" %}

{% block head %}
<style>
{% include "mockups/mockups.css" %}

/* ---- Bento grid: 12 columns on desktop, 2 on tablets, 1 on phones ---- */
.bento {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1rem;
}

.bento > * { grid-column: span 12; }

.bento-hero    { grid-column: span 8; grid-row: span 2; display: flex; align-items: center; padding: 2.5rem; }
.bento-photo   { grid-column: span 4; grid-row: span 2; padding: 0; overflow: hidden; }
.bento-latest  { grid-column: span 5; }
.bento-tycho   { grid-column: span 3; }
.bento-contact { grid-column: span 4; }
.bento-about   { grid-column: span 6; }
.bento-project { grid-column: span 4; }

.bento-photo img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 320px;
    object-fit: cover;
}

.bento-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-top: 2rem;
}

.bento-heading .mk-section-title { margin: 0; }

/* Latest post: thumbnail + text side by side */
.bento-latest {
    display: grid;
    grid-template-columns: 42% 1fr;
    gap: 1.25rem;
    align-items: center;
}

.bento-latest img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 6px;
    object-fit: cover;
}

.bento-latest h3,
.bento-project h3 {
    margin: 0.4rem 0 0.6rem;
    font-family: var(--font-pixel);
    font-size: 1rem;
    line-height: 1.4;
}

.bento-date {
    color: var(--accent);
    font-size: 0.8rem;
    letter-spacing: 1px;
    text-transform: uppercase;
}

.bento-tycho {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.bento-tycho strong {
    font-family: var(--font-pixel);
    font-size: 1.1rem;
    line-height: 1.4;
}

.bento-about h2 {
    margin: 0 0 1rem;
    color: var(--accent);
    font-family: var(--font-pixel);
    font-size: 1rem;
}

.bento-about p { margin: 0; }

/* Project tiles: image on top, text below */
.bento-project {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
}

.bento-project img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-bottom: 1px solid var(--border);
}

.bento-project-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.25rem 1.5rem 1.5rem;
}

.bento-project p { margin: 0 0 1rem; font-size: 0.95rem; }
.bento-project .mk-arrow-link { margin-top: auto; }

@media (max-width: 1024px) {
    .bento-hero    { grid-column: span 12; grid-row: auto; }
    .bento-photo   { grid-column: span 12; grid-row: auto; max-height: 420px; }
    .bento-latest  { grid-column: span 12; }
    .bento-tycho,
    .bento-contact,
    .bento-about,
    .bento-project { grid-column: span 6; }
}

@media (max-width: 768px) {
    .bento > *,
    .bento-tycho,
    .bento-contact,
    .bento-about,
    .bento-project { grid-column: span 12; }
    .bento-hero { padding: 1.75rem; }
    .bento-latest { grid-template-columns: 1fr; }
}
</style>
{% endblock %}

{% block content %}
{# Newest published post (drafts are visible in npm start, skip them here). #}
{%- set latest = collections.post | published | last %}
<div class="mk-page">
	<div class="bento">

		<section class="mk-tile bento-hero" id="welcome">
			{% include "mockups/hero.njk" %}
		</section>

		<div class="mk-tile bento-photo">
			<img src="{{ home.photo }}" alt="{{ home.photoAlt }}" loading="eager" sizes="(max-width: 1024px) 100vw, 400px">
		</div>

		<a class="mk-tile bento-latest" href="{{ latest.url }}">
			<img src="{{ latest.data.image }}" alt="" sizes="(max-width: 768px) 100vw, 260px">
			<div>
				<p class="mk-label">Latest post</p>
				<time class="bento-date" datetime="{{ latest.date | isoDate }}">{{ latest.date | readableDate }}</time>
				<h3>{{ latest.data.title }}</h3>
				<p class="mk-muted mk-clamp">{{ latest.data.description }}</p>
				<span class="mk-arrow-link">Read →</span>
			</div>
		</a>

		<a class="mk-tile bento-tycho" href="{{ home.tycho.url }}" target="_blank" rel="noopener noreferrer">
			<p class="mk-label">Side project</p>
			<strong>{{ home.tycho.title }}</strong>
			<p class="mk-muted">{{ home.tycho.text }}</p>
			<span class="mk-arrow-link">Visit ↗</span>
		</a>

		<section class="mk-tile bento-contact" id="contact">
			<p class="mk-label">Contact</p>
			{% include "mockups/contact.njk" %}
		</section>

		{%- for block in home.about %}
		<section class="mk-tile bento-about"{% if loop.first %} id="about"{% endif %}>
			<h2>{{ block.title }}</h2>
			<p class="mk-muted">{{ block.text }}</p>
		</section>
		{%- endfor %}

		<div class="bento-heading" id="projects">
			<h2 class="mk-section-title">Projects</h2>
			<a class="mk-arrow-link" href="/blog/">All posts →</a>
		</div>

		{%- for project in collections.project %}
		{%- set hasLink = project.data.show_link and project.data.link %}
		<article class="mk-tile bento-project{% if hasLink %} mk-tile--link{% endif %}">
			<img src="{{ project.data.image }}" alt="" sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 400px">
			<div class="bento-project-body">
				<h3>{{ project.data.title }}</h3>
				<p class="mk-muted mk-clamp">{{ project.data.description }}</p>
				{%- if hasLink %}
				<a class="mk-arrow-link" href="{{ project.data.link }}"{% if project.data.link.startsWith('http') %} target="_blank" rel="noopener noreferrer"{% endif %}>View project →</a>
				{%- endif %}
			</div>
		</article>
		{%- endfor %}

	</div>
</div>
{% endblock %}
