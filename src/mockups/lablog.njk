---
# Redesign mockup C. Draft: visible with `npm start` at /mockups/lablog/, never published.
title: "Mockup C: Lab log"
draft: true
permalink: /mockups/lablog/
---
{% extends "layouts/base.njk" %}

{% block head %}
<style>
{% include "mockups/mockups.css" %}

/* ---- Hero: text left, photo right ---- */
.log-hero {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    align-items: center;
    gap: 3rem;
    min-height: 68vh;
}

.log-hero-photo {
    justify-self: end;
    width: 100%;
    max-width: 360px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 8px;
    box-shadow: 0 0 30px rgba(0, 0, 0, 0.5);
}

.log-hero-photo img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
}

/* ---- Timeline ---- */
.log-intro { margin: -0.75rem 0 2rem; }

.log-year {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 2.5rem 0 1.25rem;
    color: var(--text-dim);
    font-family: var(--font-pixel);
    font-size: 1.4rem;
}

.log-year::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--border);
}

/* date | rail with a hexagon node | card */
.log-entry {
    display: grid;
    grid-template-columns: 90px 24px 1fr;
    gap: 0 1.25rem;
}

.log-date {
    padding-top: 1.6rem;
    color: var(--accent);
    font-family: var(--font-pixel);
    font-size: 0.75rem;
    line-height: 1.6;
    text-align: right;
}

.log-rail { position: relative; }

.log-rail::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: var(--border);
}

.log-rail::after {
    content: "";
    position: absolute;
    top: 1.6rem;
    left: 50%;
    width: 14px;
    height: 16px;
    background: var(--accent);
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    filter: drop-shadow(0 0 8px var(--accent));
    transform: translateX(-50%);
}

.log-entry--project .log-rail::after {
    background: var(--text-dim);
    filter: none;
}

.log-card {
    display: grid;
    grid-template-columns: 1fr 200px;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 1.25rem;
}

.log-card h3 {
    margin: 0.6rem 0 0.5rem;
    font-family: var(--font-pixel);
    font-size: 1.05rem;
    line-height: 1.4;
}

.log-card p { margin: 0 0 0.8rem; }

.log-card img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 6px;
    object-fit: cover;
}

.log-type {
    display: inline-block;
    padding: 3px 8px;
    border: 1px solid var(--accent);
    border-radius: 4px;
    color: var(--accent);
    font-family: var(--font-pixel);
    font-size: 0.55rem;
}

.log-entry--project .log-type {
    border-color: var(--border);
    color: var(--text-dim);
}

.log-date-inline { display: none; }

/* Projects without a date */
.log-earlier {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
}

.log-earlier .mk-tile { padding: 0; overflow: hidden; }

.log-earlier img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-bottom: 1px solid var(--border);
}

.log-earlier-body { padding: 1.1rem 1.3rem 1.3rem; }
.log-earlier h3 { margin: 0 0 0.5rem; font-family: var(--font-pixel); font-size: 0.9rem; line-height: 1.4; }
.log-earlier p { margin: 0 0 0.8rem; font-size: 0.9rem; }

/* ---- About + contact ---- */
.log-bottom {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1rem;
}

.log-bottom h2 {
    margin: 0 0 1rem;
    color: var(--accent);
    font-family: var(--font-pixel);
    font-size: 1rem;
}

.log-bottom p { margin: 0; }

@media (max-width: 1024px) {
    .log-earlier { grid-template-columns: repeat(2, 1fr); }
    .log-bottom { grid-template-columns: 1fr 1fr; }
    .log-bottom .mk-tile:last-child { grid-column: span 2; }
}

@media (max-width: 768px) {
    .log-hero {
        grid-template-columns: 1fr;
        gap: 2rem;
        min-height: auto;
        padding-top: 1rem;
    }

    .log-hero-photo { justify-self: center; max-width: 300px; }

    /* Narrow timeline: rail on the left, date moves into the card. */
    .log-entry { grid-template-columns: 16px 1fr; gap: 0 0.9rem; }
    .log-date { display: none; }
    .log-date-inline { display: inline; margin-left: 0.5rem; color: var(--accent); font-size: 0.8rem; }
    .log-card { grid-template-columns: 1fr; }
    .log-card img { order: -1; }
    .log-earlier,
    .log-bottom { grid-template-columns: 1fr; }
    .log-bottom .mk-tile:last-child { grid-column: auto; }
}
</style>
{% endblock %}

{% block content %}
<div class="mk-page">

	<section class="log-hero" id="welcome">
		{% include "mockups/hero.njk" %}
		<div class="log-hero-photo">
			<img src="{{ home.photo }}" alt="{{ home.photoAlt }}" loading="eager" sizes="(max-width: 768px) 300px, 360px">
		</div>
	</section>

	<section id="projects">
		<h2 class="mk-section-title">Lab log</h2>
		<p class="mk-muted log-intro">Posts and projects, newest first.</p>

		{%- for group in collections.labLog.years %}
		<div class="log-year">{{ group.year }}</div>
		{%- for entry in group.entries %}
		{%- set item = entry.item %}
		{%- set url = item.url if entry.type == 'post' else (item.data.link if item.data.show_link else '') %}
		<div class="log-entry log-entry--{{ entry.type }}">
			<time class="log-date" datetime="{{ entry.date | isoDate }}">{{ (entry.date | readableDate).slice(0, 6) }}</time>
			<div class="log-rail" aria-hidden="true"></div>
			<article class="mk-tile log-card{% if url %} mk-tile--link{% endif %}">
				<div>
					<span class="log-type">{{ 'Post' if entry.type == 'post' else 'Project' }}</span>
					<span class="log-date-inline">{{ entry.date | readableDate }}</span>
					<h3>{{ item.data.title }}</h3>
					<p class="mk-muted mk-clamp">{{ item.data.description }}</p>
					{%- if url %}
					<a class="mk-arrow-link" href="{{ url }}">{{ 'Read' if entry.type == 'post' else 'View project' }} →</a>
					{%- endif %}
				</div>
				<img src="{{ item.data.image }}" alt="" sizes="(max-width: 768px) 100vw, 200px">
			</article>
		</div>
		{%- endfor %}
		{%- endfor %}

		{%- if collections.labLog.undated.length %}
		<div class="log-year">Earlier projects</div>
		<div class="log-earlier">
			{%- for project in collections.labLog.undated %}
			{%- set hasLink = project.data.show_link and project.data.link %}
			<article class="mk-tile{% if hasLink %} mk-tile--link{% endif %}">
				<img src="{{ project.data.image }}" alt="" sizes="(max-width: 768px) 100vw, 380px">
				<div class="log-earlier-body">
					<h3>{{ project.data.title }}</h3>
					<p class="mk-muted mk-clamp">{{ project.data.description }}</p>
					{%- if hasLink %}
					<a class="mk-arrow-link" href="{{ project.data.link }}"{% if project.data.link.startsWith('http') %} target="_blank" rel="noopener noreferrer"{% endif %}>View project →</a>
					{%- endif %}
				</div>
			</article>
			{%- endfor %}
		</div>
		{%- endif %}
	</section>

	<h2 class="mk-section-title" id="about">About</h2>
	<div class="log-bottom">
		{%- for block in home.about %}
		<section class="mk-tile">
			<h2>{{ block.title }}</h2>
			<p class="mk-muted">{{ block.text }}</p>
		</section>
		{%- endfor %}
		<section class="mk-tile" id="contact">
			<h2>Contact</h2>
			<p class="mk-muted" style="margin-bottom: 1rem">{{ home.contact.intro }}</p>
			{% include "mockups/contact.njk" %}
		</section>
	</div>

</div>
{% endblock %}
