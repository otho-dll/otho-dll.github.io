{% extends "layouts/base.njk" %}
{#- Home page. All texts and options: src/content/settings.yml. Styles: css/home.css. -#}

{% block head %}
	<link rel="stylesheet" href="{{ '/css/home.css' | versioned }}">
{% endblock %}

{#- One Maker log entry: a post, a project, or a project together with its write-up post. -#}
{% macro logEntry(entry) %}
	{%- set item = entry.item %}
	{%- if entry.type == 'post' %}
		{%- set url = item.url %}{% set linkText = 'Read →' %}{% set external = false %}
	{%- elif entry.post %}
		{%- set url = entry.post.url %}{% set linkText = 'Read the write-up →' %}{% set external = false %}
	{%- elif item.data.show_link and item.data.link %}
		{%- set url = item.data.link %}{% set external = item.data.link.startsWith('http') %}
		{%- set linkText = 'View project ↗' if external else 'View project →' %}
	{%- else %}
		{%- set url = '' %}
	{%- endif %}
	{#- Tags: the project's own, else those of its write-up post. #}
	{%- set tags = item.data.article_tags or (entry.post.data.article_tags if entry.post else []) %}
	<article class="log-entry log-entry--{{ entry.type }}">
		{%- if entry.date %}
		<time class="log-date" datetime="{{ entry.date | isoDate }}">{{ (entry.date | readableDate).slice(0, 6) }}</time>
		{%- else %}
		<span class="log-date" aria-hidden="true">—</span>
		{%- endif %}
		<div class="log-rail" aria-hidden="true"></div>
		<div class="log-card">
			<div class="log-body">
				<p class="log-meta">
					{%- if entry.type == 'post' %}<span class="log-type log-type--post">Post</span>
					{%- else %}<span class="log-type log-type--project">Project</span>{% if entry.post %}<span class="log-type log-type--post">Post</span>{% endif %}
					{%- endif %}
					{%- if entry.date %}<span class="log-date-inline">{{ entry.date | readableDate }}</span>{% endif %}
				</p>
				<h4>{{ item.data.title }}</h4>
				<p class="muted clamp">{{ item.data.description }}</p>
				{%- if tags and tags.length %}
				<ul class="log-tags" aria-label="Tags">
					{%- for tag in tags %}<li>{{ tag }}</li>{% endfor %}
				</ul>
				{%- endif %}
				{%- if url %}
				<a class="arrow-link" href="{{ url }}"{% if external %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ linkText }}</a>
				{%- endif %}
			</div>
			{%- if item.data.image %}
			<img src="{{ item.data.image }}" alt="" sizes="(max-width: 768px) 100vw, 180px">
			{%- endif %}
		</div>
	</article>
{% endmacro %}

{% block content %}
{%- set featuredLayout = settings.featured.layout if settings.featured.show else 'none' %}
<div class="home featured-is-{{ featuredLayout }}">
	<div class="bento">

		<section class="tile bento-hero" id="welcome">
			<p class="hero-greeting">{{ settings.greeting }}</p>
			<h1 class="hero-name">{{ settings.name }}</h1>
			{# Roles are typed out by js/modules/typing.js; the first one is rendered for no-JS visitors. #}
			<p class="hero-role" data-roles="{{ settings.roles | dump }}">
				<span class="typing-text">{{ settings.roles[0] }}</span><span class="cursor" aria-hidden="true">|</span>
			</p>
			<p class="hero-intro">{{ settings.intro }}</p>
		</section>

		<div class="tile bento-photo">
			<img src="{{ settings.photo }}" alt="{{ settings.photo_alt }}" loading="eager" fetchpriority="high" sizes="(max-width: 1024px) 100vw, 400px">
		</div>

		{%- for block in settings.about %}
		<section class="tile bento-about"{% if loop.first %} id="about"{% endif %}>
			<h2 class="tile-title">{{ block.title }}</h2>
			<p class="muted">{{ block.text }}</p>
		</section>
		{%- endfor %}

		{%- if featuredLayout == 'compact' %}
		{% include "partials/featured.njk" %}
		{%- endif %}

		<section class="tile bento-social" id="contact">
			<h2 class="tile-title">{{ settings.social_title }}</h2>
			<p class="muted">{{ settings.social_intro }}</p>
			<div class="social-links">
				{%- for link in settings.social %}
				{%- if link.copy %}
				<button type="button" class="social-link" data-copy="{{ link.handle }}" aria-label="Copy {{ link.name }}: {{ link.handle }}">
				{%- else %}
				{%- set external = link.url.startsWith('http') %}
				<a class="social-link" href="{{ link.url }}"{% if external %} target="_blank" rel="noopener noreferrer"{% endif %}>
				{%- endif %}
					<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="{{ link.icon }}"/></svg>
					<span class="social-link-text">
						<span class="social-link-name">{{ link.name }}</span>
						<span{% if link.copy %} data-copy-label{% endif %}>{{ link.handle }}</span>
					</span>
					<span class="social-link-hint" aria-hidden="true">{{ 'copy' if link.copy else '↗' }}</span>
				{%- if link.copy %}</button>{% else %}</a>{% endif %}
				{%- endfor %}
			</div>
		</section>

		{%- if featuredLayout == 'wide' %}
		{% include "partials/featured.njk" %}
		{%- endif %}

		{#- Maker log: one tab per year (js/modules/tabs.js). Without JS all years are listed. -#}
		{%- set log = collections.makerLog %}
		<section class="tile bento-log" id="projects" aria-labelledby="log-title" data-tabs>
			<div class="log-head">
				<h2 class="tile-title" id="log-title">{{ settings.maker_log_title }}</h2>
				<div class="log-tabs" role="tablist" aria-label="Year">
					{%- for group in log.years %}
					<button type="button" role="tab" id="log-tab-{{ group.year }}" aria-controls="log-{{ group.year }}" aria-selected="{{ 'true' if loop.first else 'false' }}">{{ group.year }}</button>
					{%- endfor %}
					{%- if log.undated.length %}
					<button type="button" role="tab" id="log-tab-earlier" aria-controls="log-earlier" aria-selected="false">Earlier</button>
					{%- endif %}
				</div>
			</div>

			{%- for group in log.years %}
			<div class="log-panel" role="tabpanel" id="log-{{ group.year }}" aria-labelledby="log-tab-{{ group.year }}">
				<h3 class="log-year">{{ group.year }}</h3>
				{%- for entry in group.entries %}
				{{ logEntry(entry) }}
				{%- endfor %}
			</div>
			{%- endfor %}

			{%- if log.undated.length %}
			<div class="log-panel" role="tabpanel" id="log-earlier" aria-labelledby="log-tab-earlier">
				<h3 class="log-year">Earlier</h3>
				{%- for project in log.undated %}
				{{ logEntry({ type: 'project', item: project }) }}
				{%- endfor %}
			</div>
			{%- endif %}
		</section>

	</div>
</div>
{% endblock %}
