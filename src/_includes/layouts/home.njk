{% extends "layouts/base.njk" %}

{% block head %}
	<link rel="stylesheet" href="{{ '/css/home.css' | versioned }}">
{% endblock %}

{% block content %}
<nav class="dot-nav" aria-label="Sections">
	<a href="#welcome" class="dot active" aria-label="Home"></a>
	<a href="#about" class="dot" aria-label="About Me"></a>
	<a href="#projects" class="dot" aria-label="My Projects"></a>
	<a href="#contact" class="dot" aria-label="Contact Me"></a>
</nav>

<div class="social-nav-floating">
	<div class="social-links-vertical">
		{%- for link in social %}
		<a href="{{ link.url }}" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="{{ link.name }}">
			<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="{{ link.icon_path }}"/></svg>
		</a>
		{%- endfor %}
	</div>
</div>

<div class="home-container">

	<section id="welcome" class="home-section hero-section">
		<div class="content hero-content">
			<h1 class="hero-greeting">{{ welcome_text | safe }}</h1>

			{# Roles are typed out by js/typing.js; the first one is rendered for no-JS visitors. #}
			<h2 class="hero-role" data-roles="{{ dynamic_texts | dump }}">
				<span class="typing-text">{{ dynamic_texts[0] }}</span><span class="cursor" aria-hidden="true">|</span>
			</h2>

			<p class="subtext">{{ under_welcome_text | safe }}</p>

			<a href="#about" class="learn-more-btn">Learn more <span aria-hidden="true">↓</span></a>
		</div>
	</section>

	<section id="about" class="home-section">
		<div class="content about-container">
			<div class="about-image-wrapper">
				{%- for img in about_images %}
				<img src="{{ img }}" alt="{{ 'Photo of Simon' if loop.first else '' }}" class="about-image about-slide{% if loop.first %} active{% endif %}" sizes="(max-width: 768px) 90vw, 420px">
				{%- endfor %}
			</div>

			<div class="about-content">
				<div class="about-block block-1">
					<h3>{{ about_title_1 | safe }}</h3>
					<p>{{ about_text_1 | safe }}</p>
				</div>
				<div class="about-block block-2">
					<h3>{{ about_title_2 | safe }}</h3>
					<p>{{ about_text_2 | safe }}</p>
				</div>
			</div>
		</div>
	</section>

	<section id="projects" class="home-section">
		<div class="content carousel-container">
			<h2 class="highlight">{{ projects_title | safe }}</h2>

			<div class="carousel-track-container">
				<ul class="carousel-track">
					{%- for project in collections.project %}
					<li class="carousel-slide" aria-roledescription="slide" aria-label="{{ loop.index }} of {{ loop.length }}">
						<article class="project-card">
							{%- if project.data.image %}
							<div class="project-image-wrapper">
								<img src="{{ project.data.image }}" alt="" class="project-image" sizes="(max-width: 768px) 100vw, 540px">
							</div>
							{%- endif %}
							<div class="project-info">
								<h3>{{ project.data.title }}</h3>
								<p>{{ project.data.description }}</p>
								{%- if project.data.show_link and project.data.link %}
								<a href="{{ project.data.link }}" class="card-btn"{% if project.data.link.startsWith('http') %} target="_blank" rel="noopener noreferrer"{% endif %}>View Project <span aria-hidden="true">→</span></a>
								{%- endif %}
							</div>
						</article>
					</li>
					{%- else %}
					<li>No projects yet.</li>
					{%- endfor %}
				</ul>
			</div>

			<div class="carousel-dots">
				{%- for project in collections.project %}
				<button type="button" class="carousel-dot{% if loop.first %} active{% endif %}" aria-label="Show project {{ loop.index }}: {{ project.data.title }}"></button>
				{%- endfor %}
			</div>

			<div class="carousel-controls">
				<button type="button" class="carousel-arrow left-arrow" aria-label="Previous project">&#10094;</button>
				<button type="button" class="carousel-arrow right-arrow" aria-label="Next project">&#10095;</button>
			</div>
		</div>
	</section>

	<section id="contact" class="home-section contact-section">
		<div class="content">
			<h2 class="highlight">Contact Me</h2>
			<p class="contact-intro">{{ contact_intro | safe }}</p>

			<div class="contact-methods">
				{%- for option in contact_options %}
				<div class="contact-method">
					<h3>{{ option.title }}</h3>
					<div class="contact-box">
						<code>{{ option.value }}</code>
					</div>
				</div>
				{%- endfor %}
			</div>
		</div>
	</section>

</div>
{% endblock %}
