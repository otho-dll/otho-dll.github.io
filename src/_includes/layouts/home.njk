{% extends "layouts/base.njk" %}

{% block head %}
	<link rel="stylesheet" href="{{ '/css/home.css' | versioned }}">
{% endblock %}

{#- One lab log entry: a post, a project, or a project together with its write-up post. -#}
{% macro logEntry(entry) %}
	{%- set item = entry.item %}
	{%- if entry.type == 'post' %}
		{%- set url = item.url %}{% set linkText = 'Read →' %}{% set external = false %}
	{%- elif entry.post %}
		{%- set url = entry.post.url %}{% set linkText = 'Read the write-up →' %}{% set external = false %}
	{%- elif item.data.show_link and item.data.link %}
		{%- set url = item.data.link %}{% set external = item.data.link.startsWith('http') %}
		{%- set linkText = 'View project ↗' if external else 'View project →' %}
	{%- else %}
		{%- set url = '' %}
	{%- endif %}
	<article class="log-entry log-entry--{{ entry.type }}">
		{%- if entry.date %}
		<time class="log-date" datetime="{{ entry.date | isoDate }}">{{ (entry.date | readableDate).slice(0, 6) }}</time>
		{%- else %}
		<span class="log-date" aria-hidden="true">—</span>
		{%- endif %}
		<div class="log-rail" aria-hidden="true"></div>
		<div class="log-card">
			<div class="log-body">
				<p class="log-meta">
					{%- if entry.type == 'post' %}<span class="log-type log-type--post">Post</span>
					{%- else %}<span class="log-type">Project</span>{% if entry.post %}<span class="log-type log-type--post">Post</span>{% endif %}
					{%- endif %}
					{%- if entry.date %}<span class="log-date-inline">{{ entry.date | readableDate }}</span>{% endif %}
				</p>
				<h4>{{ item.data.title }}</h4>
				<p class="muted clamp">{{ item.data.description }}</p>
				{%- if url %}
				<a class="arrow-link" href="{{ url }}"{% if external %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ linkText }}</a>
				{%- endif %}
			</div>
			{%- if item.data.image %}
			<img src="{{ item.data.image }}" alt="" sizes="(max-width: 768px) 100vw, 180px">
			{%- endif %}
		</div>
	</article>
{% endmacro %}

{% block content %}
<div class="home">
	<div class="bento">

		<section class="tile bento-hero" id="welcome">
			<p class="hero-greeting">{{ home.greeting }}</p>
			<h1 class="hero-name">{{ home.name }}</h1>
			{# Roles are typed out by js/modules/typing.js; the first one is rendered for no-JS visitors. #}
			<p class="hero-role" data-roles="{{ home.roles | dump }}">
				<span class="typing-text">{{ home.roles[0] }}</span><span class="cursor" aria-hidden="true">|</span>
			</p>
			<p class="hero-intro">{{ home.intro }}</p>
			<div class="hero-actions">
				<a class="pill-btn pill-btn--solid" href="#projects">Projects <span aria-hidden="true">↓</span></a>
				<a class="pill-btn" href="/blog/">Blog <span aria-hidden="true">→</span></a>
			</div>
		</section>

		<div class="tile bento-photo">
			<img src="{{ home.photo }}" alt="{{ home.photoAlt }}" loading="eager" fetchpriority="high" sizes="(max-width: 1024px) 100vw, 400px">
		</div>

		{#- Lab log: one tab per year (js/modules/tabs.js). Without JS all years are listed. -#}
		{%- set log = collections.labLog %}
		<section class="tile bento-log" id="projects" aria-labelledby="log-title" data-tabs>
			<div class="log-head">
				<h2 class="tile-title" id="log-title">Lab log</h2>
				<div class="log-tabs" role="tablist" aria-label="Year">
					{%- for group in log.years %}
					<button type="button" role="tab" id="log-tab-{{ group.year }}" aria-controls="log-{{ group.year }}" aria-selected="{{ 'true' if loop.first else 'false' }}">{{ group.year }}</button>
					{%- endfor %}
					{%- if log.undated.length %}
					<button type="button" role="tab" id="log-tab-earlier" aria-controls="log-earlier" aria-selected="false">Earlier</button>
					{%- endif %}
				</div>
			</div>

			{%- for group in log.years %}
			<div class="log-panel" role="tabpanel" id="log-{{ group.year }}" aria-labelledby="log-tab-{{ group.year }}">
				<h3 class="log-year">{{ group.year }}</h3>
				{%- for entry in group.entries %}
				{{ logEntry(entry) }}
				{%- endfor %}
			</div>
			{%- endfor %}

			{%- if log.undated.length %}
			<div class="log-panel" role="tabpanel" id="log-earlier" aria-labelledby="log-tab-earlier">
				<h3 class="log-year">Earlier</h3>
				{%- for project in log.undated %}
				{{ logEntry({ type: 'project', item: project }) }}
				{%- endfor %}
			</div>
			{%- endif %}
		</section>

		{%- for block in home.about %}
		<section class="tile bento-about"{% if loop.first %} id="about"{% endif %}>
			<h2 class="tile-title">{{ block.title }}</h2>
			<p class="muted">{{ block.text }}</p>
		</section>
		{%- endfor %}

		<a class="tile tile--link bento-tycho" href="{{ home.tycho.url }}" target="_blank" rel="noopener noreferrer">
			<p class="tile-label">Side project</p>
			<strong>{{ home.tycho.title }}</strong>
			<p class="muted">{{ home.tycho.text }}</p>
			<span class="arrow-link">Visit ↗</span>
		</a>

		<section class="tile bento-social" id="contact">
			<h2 class="tile-title">Social</h2>
			<p class="muted">{{ home.socialIntro }}</p>
			<div class="social-links">
				<button type="button" class="social-link" data-copy="{{ home.discord }}" aria-label="Copy Discord username {{ home.discord }}">
					<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20 2H4a2 2 0 0 0-2 2v18l4-4h14a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2z"/></svg>
					<span class="social-link-text"><span class="social-link-name">Discord</span><span data-copy-label>{{ home.discord }}</span></span>
					<span class="social-link-hint" aria-hidden="true">copy</span>
				</button>
				{%- for link in social %}
				{%- set external = link.url.startsWith('http') %}
				<a class="social-link" href="{{ link.url }}"{% if external %} target="_blank" rel="noopener noreferrer"{% endif %}>
					<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="{{ link.icon_path }}"/></svg>
					<span class="social-link-text"><span class="social-link-name">{{ link.name }}</span><span>{{ link.handle }}</span></span>
					<span class="social-link-hint" aria-hidden="true">↗</span>
				</a>
				{%- endfor %}
			</div>
		</section>

	</div>
</div>
{% endblock %}
