<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">

	{#- Apply the saved theme (or the system one) before anything is painted. See js/modules/theme.js. #}
	<script>
		(() => {
			let theme = null;
			try { theme = localStorage.getItem('theme'); } catch {}
			if (theme !== 'light' && theme !== 'dark') {
				theme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
			}
			document.documentElement.dataset.theme = theme;
		})();
	</script>

	{%- set siteName = settings.site.name %}
	{%- set pageTitle = title if title == siteName else siteName + " • " + title %}
	{%- set pageDescription = description or settings.site.description %}
	{%- set socialImage = (image or settings.site.share_image) | ogImage %}
	<title>{{ pageTitle }}</title>
	<meta name="description" content="{{ pageDescription }}">
	<link rel="canonical" href="{{ page.url | absoluteUrl(site.url) }}">

	<meta property="og:type" content="{{ 'article' if layout == 'post' else 'website' }}">
	<meta property="og:site_name" content="{{ siteName }}">
	<meta property="og:title" content="{{ title }}">
	<meta property="og:description" content="{{ pageDescription }}">
	<meta property="og:url" content="{{ page.url | absoluteUrl(site.url) }}">
	<meta property="og:image" content="{{ socialImage | absoluteUrl(site.url) }}">
	<meta name="twitter:card" content="summary_large_image">

	<link rel="icon" type="image/png" href="/images/favicon.png">

	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Roboto+Mono:ital,wght@0,100..700;1,100..700&display=swap">

	<link rel="stylesheet" href="{{ '/css/style.css' | versioned }}">
	<link rel="stylesheet" href="{{ '/css/partials/chrome.css' | versioned }}">
	{%- block head %}{% endblock %}

	<script type="module" src="{{ '/js/main.js' | versioned }}"></script>
	{# Fetch the background modules in parallel with main.js instead of after it. #}
	<link rel="modulepreload" href="/js/modules/background.js">
	<link rel="modulepreload" href="/js/modules/motion.js">
</head>
<body>
	<canvas class="page-background" aria-hidden="true"></canvas>
	{% include "partials/site-mark.njk" %}
	<main class="site-main">
		{% block content %}{% endblock %}
	</main>
	{% include "partials/footer.njk" %}
</body>
</html>
