{# Footer: one tile in the same grid width as the page. Texts come from settings.yml (footer). #}
<footer class="site-footer">
	<div class="footer-tile">
		<a class="footer-logo" href="/" aria-label="{{ settings.site.name }} home">
			<img src="{{ settings.site.logo }}" alt="" sizes="120px">
		</a>

		<nav class="footer-links" aria-label="Footer">
			<a href="/">Home</a>
			<a href="/#about">About</a>
			<a href="/#contact">{{ settings.social_title }}</a>
			<a href="/#projects">{{ settings.maker_log_title }}</a>
		</nav>

		<div class="footer-meta">
			<p>Made with <span class="heart" aria-label="love">💛</span> by {{ settings.name }} · &copy; {{ settings.footer.since }}–{{ site.year }} {{ settings.footer.owner }}</p>
			{%- for note in settings.footer.notes %}
			<p>{{ note }}</p>
			{%- endfor %}
		</div>
	</div>
</footer>
