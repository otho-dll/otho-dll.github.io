{#
	There is no header bar: just a thin line above the content with a small logo and the theme button.
	The logo has a separate file for the light theme (dark text, same cube); CSS shows the right one.
	Styles: css/partials/chrome.css
#}
<div class="top-line">
	<a class="top-line-logo" href="/" aria-label="{{ settings.site.name }} home">
		{% include "partials/logo.njk" %}
	</a>
	<button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false" aria-label="Switch to light theme">
		{# Moon is shown in the dark theme, sun in the light theme. #}
		<svg class="icon-moon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
		<svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 1.5v2.5M12 20v2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M1.5 12H4M20 12h2.5M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8"/></svg>
	</button>
</div>
