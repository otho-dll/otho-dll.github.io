<header class="siteHeader">
	<div class="headerLogo">
		<a href="{{ navigation.logo.url }}">
			<img src="{{ navigation.logo.src }}" alt="{{ navigation.logo.alt }}" loading="eager" fetchpriority="high" sizes="150px">
		</a>
	</div>

	<button class="hamburger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">
		<span class="hamburger-box">
			<span class="hamburger-inner"></span>
		</span>
	</button>

	<nav aria-label="Main">
		<ul class="nav__list" id="site-nav">
			{%- for item in navigation.itemsHeader %}
			<li>
				<a class="linkHeader" href="{{ item.url }}"{{ helpers.getLinkActiveState(item.url, page.url) | safe }}>{{ item.text }}</a>
			</li>
			{%- endfor %}
			<li>
				<a href="/#contact" class="header-cta-btn">Contact Me</a>
			</li>
			{# Social links are only shown inside the mobile menu. #}
			<li class="mobile-socials">
				{%- for link in social %}
				<a href="{{ link.url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ link.name }}">
					<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="{{ link.icon_path }}"/></svg>
				</a>
				{%- endfor %}
			</li>
		</ul>
	</nav>
</header>
